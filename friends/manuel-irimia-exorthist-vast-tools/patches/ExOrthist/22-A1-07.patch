+### protein_id shared by several transcripts (identical CDS): only the CDS lines of the first transcript are used
+my %prot_first_tr;
+sub dup_prot {
+    my ($prot,$attr,$scope)=@_;
+    my ($t)=$attr=~/transcript_id \"(.+?)\"/;
+    $t="" unless defined $t;
+    if (!defined $prot_first_tr{$scope}{$prot}){ $prot_first_tr{$scope}{$prot}=$t; return 0; }
+    return ($prot_first_tr{$scope}{$prot} ne $t) ? 1 : 0;
 }
 
